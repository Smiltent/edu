
<%- include('../components/$header.ejs') %>

<div class="main flex-col">
    <h1>manage</h1>
    <p>web push: <%= pushReady ? "enabled" : "disabled (missing VAPID keys)" %></p>
    <p>push subscriptions: <span id="pushSubs"><%= pushSubs %></span></p>
    <p id="notifyStatus" class="c-yellow"></p>
    <form action="/v2/admin/refreshWeeks" method="POST">
        <input type="submit" value="refresh all weeks from schedule">
    </form>
    <form action="/v2/admin/refreshDatabase" method="POST">
        <input type="submit" value="refresh all weeks in database">
    </form>
    <form id="testNotifyForm" action="/v2/admin/sendTestNotification" method="POST">
        <input type="submit" value="send test push notification">
    </form>
    <form id="specificNotifyForm" action="/v2/admin/sendSpecificTestNotification" method="POST">
        <input type="text" name="week" placeholder="week" required>
        <input type="text" name="clazz" placeholder="class" required>
        <input type="text" name="type" placeholder="type" value="update" required>
        <input type="submit" value="send specific test notification">
    </form>

    <h2>subject remaps</h2>
    <p id="remapStatus" class="c-yellow"></p>
    <form id="remapForm">
        <input type="text" name="classes" placeholder="classes (comma: IPa24, IPb24)" required>
        <input type="text" name="groups" placeholder="groups (optional, comma)">
        <input type="text" name="teachers" placeholder="teachers (optional, comma)">
        <input type="text" name="matchName" placeholder="from subject (Edupage)" required>
        <input type="text" name="toName" placeholder="to subject" required>
        <input type="text" name="note" placeholder="note (optional)">
        <input type="submit" value="add remap">
    </form>
    <div id="remapList" class="flex-col"></div>
</div>

<script type="module" src="/public/js/admin.js"></script>
