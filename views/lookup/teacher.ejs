
<%- include('../partials/$header.ejs') %>

<div class="main flex-col">
    <h1><%= t("lookup.teacher") %></h1>
    <div class="controls">
        <div class="field">
            <label for="selectWeek"><%= t("week") %></label>
            <select id="selectWeek"></select>
        </div>

        <div class="field">
            <label for="selectTeacher"><%= t("teacher") %></label>
            <select id="selectTeacher"></select>
        </div>

        <button id="downloadBtn"><%= t("download") %></button>
    </div>

    <div id="tableContainer"></div>
</div>

<script type="module">
    import { settings, setup } from "/public/js/lookup.js"
    const params = new URLSearchParams(window.location.search)

    settings.elements.week = document.getElementById('selectWeek')
    settings.elements.main = document.getElementById('selectTeacher')

    var ignore = [false, false]
    if (localStorage.getItem("lastLookupTeacher") != null) {
        settings.values.main = localStorage.getItem("lastLookupTeacher")
        ignore[1] = true
    }

    if (params.get("week") != null) {
        settings.values.week = params.get("week")
        ignore[0] = true
    }
    if (params.get("teacher") != null) {
        settings.values.main = params.get("teacher")
        ignore[1] = true
    }

    setup("teacher", ignore)
</script>


<!-- download schedule system -->
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script type="module" src="/public/js/download.js"></script>
