
<%- include('../components/$header.ejs') %>

<div class="main flex-col">
    <h1><%= t("lookup.class") %></h1>
    <div class="controls">
        <div class="field">
            <label for="selectWeek"><%= t("week") %></label>
            <select id="selectWeek"></select>
        </div>

        <div class="field">
            <label for="selectClass"><%= t("class") %></label>
            <select id="selectClass"></select>
        </div>

        <button id="downloadBtn"><%= t("download") %></button>
    </div>

    <div id="tableContainer"></div>
</div>

<!-- show data system -->
<script type="module">
    import { settings, setup } from "/public/js/lookup.js"
    const params = new URLSearchParams(window.location.search)

    settings.elements.week = document.getElementById('selectWeek')
    settings.elements.main = document.getElementById('selectClass')

    var ignore = [false, false]
    if (localStorage.getItem("lastLookupClass")) {
        console.log("hi") // unsure when this stray console.log hi was added, but im keeping it
        settings.values.main = localStorage.getItem("lastLookupClass")
        ignore[1] = true
    }

    if (params.get("week") != null) {
        settings.values.week = params.get("week")
        ignore[0] = true
    }
    if (params.get("class") != null) {
        settings.values.main = params.get("class")
        ignore[1] = true
    }

    setup("class", ignore)
</script>

<!-- download schedule system -->
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script type="module" src="/public/js/download.js"></script>
