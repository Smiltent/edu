
# Scraper.ts
WEBSITE_URL=(..).edupage.org                    ##  url

# MongoDB.ts
CONNECTION_STRING=mongodb://database/schedule   ##  connection string for mongodb database

# Express.ts
PORT=3000                                       ##  port for express server
REGISTER=true                                   ##  allow user registration
SESSION_TTL_DAYS=7                              ##  how long a login session stays valid
TRACKING_CODE=0      # <script>...</script>     ##  optional tracking. set to 0 to disable

ENV=dev      ## [ dev, prod ]                   ##  define the env